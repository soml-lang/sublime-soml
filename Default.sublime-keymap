[
	// Close a block string when the third quote is typed: `key: ''|` becomes `key: '''|'''`. Only before whitespace, a comma, or a closing bracket, as the default quote bindings, and not in a string or a comment. At the end of the document, the caret has the scope of the `'` before it, which ends a string.
	{
		"keys": ["'"],
		"command": "insert_snippet",
		"args": {"contents": "'$0'''"},
		"context": [
			{"key": "setting.auto_match_enabled"},
			{"key": "selector", "operand": "source.soml - comment - (string - punctuation.definition.string.end)"},
			{"key": "selection_empty", "match_all": true},
			{"key": "preceding_text", "operator": "regex_contains", "operand": "(?<!')''$", "match_all": true},
			{"key": "following_text", "operator": "regex_contains", "operand": "^(?:[ \\t,\\]}]|$)", "match_all": true}
		]
	},
	{
		"keys": ["\""],
		"command": "insert_snippet",
		"args": {"contents": "\"$0\"\"\""},
		"context": [
			{"key": "setting.auto_match_enabled"},
			{"key": "selector", "operand": "source.soml - comment - (string - punctuation.definition.string.end)"},
			{"key": "selection_empty", "match_all": true},
			{"key": "preceding_text", "operator": "regex_contains", "operand": "(?<!\")\"\"$", "match_all": true},
			{"key": "following_text", "operator": "regex_contains", "operand": "^(?:[ \\t,\\]}]|$)", "match_all": true}
		]
	},

	// Put the content of a new block string on its own line, because the opening delimiter must be followed by a line break: `'''|'''` becomes three lines. Only in the opening delimiter, because a block string with a longer delimiter can have `'''` in its content.
	{
		"keys": ["enter"],
		"command": "insert_snippet",
		"args": {"contents": "\n$0\n"},
		"context": [
			{"key": "setting.auto_match_enabled"},
			{"key": "selector", "operand": "source.soml string.quoted.single.block punctuation.definition.string.begin"},
			{"key": "selection_empty", "match_all": true},
			{"key": "preceding_text", "operator": "regex_contains", "operand": "(?<!')'''$", "match_all": true},
			{"key": "following_text", "operator": "regex_contains", "operand": "^'''(?!')", "match_all": true}
		]
	},
	{
		"keys": ["enter"],
		"command": "insert_snippet",
		"args": {"contents": "\n$0\n"},
		"context": [
			{"key": "setting.auto_match_enabled"},
			{"key": "selector", "operand": "source.soml string.quoted.double.block punctuation.definition.string.begin"},
			{"key": "selection_empty", "match_all": true},
			{"key": "preceding_text", "operator": "regex_contains", "operand": "(?<!\")\"\"\"$", "match_all": true},
			{"key": "following_text", "operator": "regex_contains", "operand": "^\"\"\"(?!\")", "match_all": true}
		]
	},

	// Undo the pairing with backspace: `'''|'''` becomes `'|'`.
	{
		"keys": ["backspace"],
		"command": "chain",
		"args": {"commands": [{"command": "left_delete"}, {"command": "right_delete"}, {"command": "left_delete"}, {"command": "right_delete"}]},
		"context": [
			{"key": "setting.auto_match_enabled"},
			{"key": "selector", "operand": "source.soml string.quoted.single.block punctuation.definition.string.begin"},
			{"key": "selection_empty", "match_all": true},
			{"key": "preceding_text", "operator": "regex_contains", "operand": "(?<!')'''$", "match_all": true},
			{"key": "following_text", "operator": "regex_contains", "operand": "^'''(?!')", "match_all": true}
		]
	},
	{
		"keys": ["backspace"],
		"command": "chain",
		"args": {"commands": [{"command": "left_delete"}, {"command": "right_delete"}, {"command": "left_delete"}, {"command": "right_delete"}]},
		"context": [
			{"key": "setting.auto_match_enabled"},
			{"key": "selector", "operand": "source.soml string.quoted.double.block punctuation.definition.string.begin"},
			{"key": "selection_empty", "match_all": true},
			{"key": "preceding_text", "operator": "regex_contains", "operand": "(?<!\")\"\"\"$", "match_all": true},
			{"key": "following_text", "operator": "regex_contains", "operand": "^\"\"\"(?!\")", "match_all": true}
		]
	}
]
